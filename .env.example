# WEBAPP SECRETS
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=securedrop-realm
VITE_KEYCLOAK_CLIENT_ID=web-app
VITE_API_BASE_URL=http://localhost:3001/api

# API SECRETS
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=securedrop-realm
KEYCLOAK_CLIENT_ID=web-app

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin


DB_HOST=api-db
DB_PORT=5432
DB_NAME=securedrop
DB_USER=securedrop_user
DB_PASSWORD=password
DB_SSL=false
# Used for Supabase connection
SUPABASE_DB_URL=postgresql://securedrop_user:password@api-db:5432/securedrop

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081
MAX_FILE_SIZE=52428800

# NODE-RED SECRETS
NODE_RED_CREDENTIAL_SECRET=securedrop-secret-key

# KEYCLOAK SECRETS
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=adminpassword

KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false

KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_LOG_LEVEL=INFO
KC_PROXY_HEADERS=xforwarded

KC_DB=postgres
KC_DB_SCHEMA=public
KC_DB_URL_HOST=db
KC_DB_URL_DATABASE=keycloak
KC_DB_PASSWORD=pass123
KC_DB_USERNAME=postgres

# MINIO SECRETS
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SERVER_URL=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

MINIO_NOTIFY_AMQP_ENABLE_rabbitmq=on
MINIO_NOTIFY_AMQP_URL_rabbitmq=amqp://user:password@rabbitmq:5672
MINIO_NOTIFY_AMQP_EXCHANGE_rabbitmq=minio-exchange
MINIO_NOTIFY_AMQP_EXCHANGE_TYPE_rabbitmq=topic
MINIO_NOTIFY_AMQP_ROUTING_KEY_rabbitmq="minio.event"
MINIO_NOTIFY_AMQP_MANDATORY_rabbitmq=on
MINIO_NOTIFY_AMQP_DURABLE_rabbitmq=on
MINIO_NOTIFY_AMQP_COMMENT_rabbitmq=RabbitMQ Event Target

# RABBITMQ SECRETS
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password

# THINGSBOARD SECRETS
TB_QUEUE_TYPE=rabbitmq
TB_QUEUE_RABBIT_MQ_USERNAME=user
TB_QUEUE_RABBIT_MQ_PASSWORD=password
TB_QUEUE_RABBIT_MQ_HOST=rabbitmq
TB_QUEUE_RABBIT_MQ_PORT=5672
