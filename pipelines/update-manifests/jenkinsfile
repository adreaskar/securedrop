pipeline {
  agent any

  parameters {
    string(name: 'CREDENTIAL_ID', defaultValue: 'manifest-repo-creds', description: 'SSH credential id with push access')
  }

  options {
    timestamps()
  }

  stages {
    stage('Clone repositories') {
      steps {
        script {
          echo 'Cloning manifests branch and source repository'
        }
        withCredentials([sshUserPrivateKey(credentialsId: params.CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
          sh '''#!/bin/bash
            set -euo pipefail

            rm -rf manifests-repo source-repo

            mkdir -p ~/.ssh
            ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null || true
            export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"

            git clone --branch manifests git@github.com:adreaskar/securedrop.git manifests-repo
            git clone git@github.com:adreaskar/securedrop.git source-repo
          '''
        }
      }
    }

    stage('Sync k8s into manifests branch') {
      steps {
        withCredentials([sshUserPrivateKey(credentialsId: params.CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
          sh '''#!/bin/bash
            set -euo pipefail

            SRC_DIR="source-repo/k8s"
            DST_DIR="manifests-repo"

            if [ ! -d "${SRC_DIR}" ]; then
              echo "Source k8s directory not found: ${SRC_DIR}. Nothing to copy."
              exit 0
            fi

            cd "${DST_DIR}"
            git config user.email "jenkins@securedrop.local"
            git config user.name "Jenkins CI"

            # Copy everything inside source k8s/ into manifests branch root.
            rsync -a --delete --exclude '.git/' ../${SRC_DIR}/ ./

            if git status --porcelain | grep -q .; then
              git add -A
              git commit -m "CI: Sync k8s folder from master"
              export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
              git push origin manifests
              echo "Manifests branch updated successfully."
            else
              echo "No manifest changes detected after sync."
            fi
          '''
        }
      }
    }
  }

  post {
    always {
      script {
        echo 'update-manifests job finished'
      }
    }
  }
}
