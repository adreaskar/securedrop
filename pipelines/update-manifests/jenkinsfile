pipeline {
  agent any

  parameters {
    string(name: 'IMAGE_MAP', defaultValue: '', description: 'Comma-separated list service=image:tag')
    string(name: 'CREDENTIAL_ID', defaultValue: 'manifest-repo-creds', description: 'SSH credential id with push access')
  }

  options {
    timestamps()
  }

  stages {
    stage('Checkout manifests repo') {
      steps {
        script {
          // repo and branch are fixed
          echo "Cloning git@github.com:adreaskar/securedrop.git branch manifests"
        }
        withCredentials([sshUserPrivateKey(credentialsId: params.CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
          sh '''
            rm -rf manifests-repo || true
            
            # Fix permissions on the SSH key if it exists
            if [ -f /var/lib/jenkins/.ssh/id_ed25519 ]; then
              chmod 600 /var/lib/jenkins/.ssh/id_ed25519
            fi
            
            # Add GitHub to known_hosts to avoid ssh key verification prompts
            mkdir -p /var/lib/jenkins/.ssh
            ssh-keyscan -t ed25519 github.com >> /var/lib/jenkins/.ssh/known_hosts 2>/dev/null || true
            
            git clone --branch "manifests" git@github.com:adreaskar/securedrop.git manifests-repo
          '''
        }
      }
    }

    stage('Update manifests') {
      steps {
        withCredentials([sshUserPrivateKey(credentialsId: params.CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
          sh '''
            #!/bin/bash
            set -euo pipefail

            if [ -z "${IMAGE_MAP}" ]; then
              echo "No IMAGE_MAP provided, nothing to do."
              exit 0
            fi

            cd manifests-repo

            # Configure git user
            git config user.email "ci@securedrop.local"
            git config user.name "CI Pipeline"

            # Fix permissions on the SSH key if it exists
            if [ -f /var/lib/jenkins/.ssh/id_ed25519 ]; then
              chmod 600 /var/lib/jenkins/.ssh/id_ed25519
            fi
            
            # Add GitHub to known_hosts to avoid ssh key verification prompts
            mkdir -p /var/lib/jenkins/.ssh
            ssh-keyscan -t ed25519 github.com >> /var/lib/jenkins/.ssh/known_hosts 2>/dev/null || true

            # Map build services to manifests branch folders
            declare -A manifestFolders=(
              ["keycloak"]="keycloak"
              ["rabbitmq"]="rabbitmq"
              ["node-red"]="nodered"
              ["securedrop"]="webapp"
              ["securedrop-api"]="api"
              ["securedrop-scanner"]="scanner"
              ["thingsboard"]="thingsboard"
            )

            # IMAGE_MAP format: svc=namespace/svc:tag,svc2=namespace2/svc2:tag
            IFS=',' read -r -a entries <<< "${IMAGE_MAP}"

            for e in "${entries[@]}"; do
              svc="${e%%=*}"
              img="${e#*=}"
              echo "Updating image for $svc -> $img"

              manifestFolder="${manifestFolders[$svc]:-}"
              if [ -z "${manifestFolder}" ]; then
                echo "No manifests folder mapping found for service: ${svc}"
                continue
              fi

              if [ ! -d "${manifestFolder}" ]; then
                echo "Manifests folder not found: ${manifestFolder}"
                continue
              fi

              # Update all image references in the mapped manifests folder
              find "${manifestFolder}" -type f \( -name "*.yaml" -o -name "*.yml" \) | while read file; do
                if grep -q "^[[:space:]]*image:[[:space:]]*" "$file"; then
                  sed -E -i.bak "s#(^[[:space:]]*image:[[:space:]]*).*$#\\1${img}#" "$file"
                  rm -f "${file}.bak"
                  echo "  Updated: $file"
                fi
              done
            done

            # Commit only if changes
            if git status --porcelain | grep -q .; then
              git add -A
              git commit -m "chore(ci): update images ${IMAGE_MAP}"
              git push origin "manifests"
            else
              echo "No manifest changes detected."
            fi
          '''
        }
      }
    }
  }

  post {
    always {
      script { echo 'update-manifests job finished' }
    }
  }
}
