// Map root-level service folders that have Dockerfiles
// These are the folders where docker builds will be triggered on changes
def rootServices = [
    'api': [dockerfiles: ['Dockerfile']],
    'webapp': [dockerfiles: ['Dockerfile.prod'], buildArgs: ['VITE_KEYCLOAK_URL','VITE_KEYCLOAK_REALM','VITE_KEYCLOAK_CLIENT_ID','VITE_API_BASE_URL']],
    'nodered': [dockerfiles: ['Dockerfile']],
    'stateless-scanner': [dockerfiles: ['Dockerfile']]
]

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Show what would be built without pushing to Docker Hub')
        string(name: 'CREDENTIAL_ID', defaultValue: 'manifest-repo-creds', description: 'SSH credential id with push access')
    }

    triggers {
        githubPush()
    }

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        VITE_KEYCLOAK_URL = "https://keycloak.securedrop.gr"
        VITE_KEYCLOAK_REALM = "securedrop-realm"
        VITE_KEYCLOAK_CLIENT_ID = "web-app"
        VITE_API_BASE_URL = "https://api.securedrop.gr/api"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_BRANCH_NAME = 'master'
                    env.GIT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"

                    echo "Branch: ${env.GIT_BRANCH_NAME}"
                    echo "Commit: ${env.GIT_COMMIT}"
                    echo "Commit Short: ${env.GIT_COMMIT_SHORT}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                    
                    echo "Pipeline running on branch: ${env.GIT_BRANCH_NAME}"
                }
            }
        }

        stage('Detect Changes') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }
            steps {
                script {
                    def changedFiles = []
                    def servicesToBuild = [] as Set
                    def k8sChangesDetected = false
                    def rootServiceChangesDetected = false

                    try {
                        def previousCommit = sh(script: 'git rev-parse HEAD~1', returnStdout: true).trim()
                        changedFiles = sh(
                            script: "git diff --name-only ${previousCommit} HEAD",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }
                    } catch (Exception e) {
                        echo "Could not get previous commit (first build?). Will process all changes."
                        changedFiles = sh(
                            script: "git diff --name-only HEAD~ HEAD || git ls-files",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }
                    }

                    if (changedFiles.isEmpty()) {
                        env.SKIP_PIPELINE = 'true'
                        currentBuild.description = 'Skipped: no changes detected'
                        echo 'No changes detected.'
                        return
                    }

                    echo "Changed files:\n${changedFiles.join('\n')}"

                    // Analyze changed files
                    for (String filePath in changedFiles) {
                        def topLevel = filePath.contains('/') ? filePath.split('/')[0] : filePath

                        // Check if change is in k8s directory
                        if (topLevel == 'k8s') {
                            k8sChangesDetected = true
                            echo "K8s directory change detected: ${filePath}"
                        }

                        // Check if change is in a root service folder with Dockerfile
                        if (rootServices.containsKey(topLevel)) {
                            servicesToBuild << topLevel
                            rootServiceChangesDetected = true
                            echo "Root service change detected in: ${topLevel}"
                        }
                    }

                    // Store results in environment
                    env.K8S_CHANGES = k8sChangesDetected ? 'true' : 'false'
                    env.ROOT_SERVICE_CHANGES = rootServiceChangesDetected ? 'true' : 'false'
                    env.SERVICES_TO_BUILD = servicesToBuild.join(',')

                    echo "\n=== Change Detection Summary ==="
                    echo "K8s changes detected: ${env.K8S_CHANGES}"
                    echo "Root service changes: ${env.ROOT_SERVICE_CHANGES}"
                    echo "Services to build: ${env.SERVICES_TO_BUILD ?: 'none'}"
                    echo "================================\n"
                }
            }
        }

        stage('Build and Push Images') {
            when {
                expression { env.ROOT_SERVICE_CHANGES == 'true' }
            }
            steps {
                script {
                    def servicesToBuild = env.SERVICES_TO_BUILD.split(',').collect { it.trim() }.findAll { it }
                    
                    echo "Building ${servicesToBuild.size()} services with tag: ${env.IMAGE_TAG}"

                    if (params.DRY_RUN) {
                        echo 'DRY RUN: No images will be built or pushed.'
                    } else {
                        sh 'echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin'
                    }

                    for (String serviceName in servicesToBuild) {
                        def serviceConfig = rootServices[serviceName]
                        def dockerfile = null
                        def buildArgsString = ''

                        // Find the first available Dockerfile
                        for (String candidate in serviceConfig.dockerfiles) {
                            def dockerfilePath = "${serviceName}/${candidate}"
                            if (fileExists(dockerfilePath)) {
                                dockerfile = dockerfilePath
                                break
                            }
                        }

                        // Build args for services that declare them
                        if (serviceConfig.containsKey('buildArgs')) {
                            def args = serviceConfig.buildArgs.collect { arg ->
                                def val = env.getProperty(arg)
                                return "--build-arg ${arg}=${val ?: ''}"
                            }
                            buildArgsString = args.join(' ')
                        }

                        if (!dockerfile) {
                            error("No Dockerfile found for service: ${serviceName}")
                        }

                        def imageName = "${DOCKERHUB_CREDENTIALS_USR}/${serviceName}"
                        def fullImageTag = "${imageName}:${env.IMAGE_TAG}"

                        echo "\n=== Building ${serviceName} ==="
                        echo "Dockerfile: ${dockerfile}"
                        echo "Image tag: ${fullImageTag}"

                        if (!params.DRY_RUN) {
                            sh """
                                docker build \
                                    -f "${dockerfile}" \
                                    ${buildArgsString} \
                                    -t "${fullImageTag}" \
                                    "./${serviceName}"
                            """

                            sh "docker push \"${fullImageTag}\""
                            echo "✓ Successfully pushed: ${fullImageTag}"
                        }
                    }

                    if (!params.DRY_RUN) {
                        sh 'docker logout'
                    }
                }
            }
        }

        stage('Update k8s directories') {
            when {
                expression { env.ROOT_SERVICE_CHANGES == 'true' }
            }
            steps {
                script {
                    def servicesToBuild = env.SERVICES_TO_BUILD.split(',').collect { it.trim() }.findAll { it }
                    
                    echo "Updating k8s manifests for built services..."

                    for (String serviceName in servicesToBuild) {
                        def k8sServiceDir = "k8s/${serviceName}"
                        def deploymentImagePattern = serviceName == 'nodered' ? 'securedrop-nodered' : serviceName
                        
                        if (!fileExists(k8sServiceDir)) {
                            echo "⚠ Warning: k8s directory not found for ${serviceName}: ${k8sServiceDir}"
                            continue
                        }

                        echo "\nUpdating deployment manifests in: ${k8sServiceDir}"

                        // Find deployment, knative and service manifests in the service k8s directory
                        def deploymentFiles = sh(
                            script: """find ${k8sServiceDir} -type f \\( -name '*deployment*.yaml' -o -name '*deployment*.yml' -o -name '*knative*.yaml' -o -name '*knative*.yml' \\)""",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }

                        def imageName = "${DOCKERHUB_CREDENTIALS_USR}/${serviceName}"
                        def newImageTag = "${imageName}:${env.IMAGE_TAG}"

                        for (String deploymentFile in deploymentFiles) {
                            if (!deploymentFile) continue
                            
                            echo "Updating image tag in deployment file: ${deploymentFile}"
                            
                            // Update the image line in deployment files only
                            sh """
                                sed -i -E 's|^([[:space:]]*image:[[:space:]]*)[^[:space:]]*${deploymentImagePattern}:[^[:space:]]+|\\1${newImageTag}|' "${deploymentFile}" || true
                            """
                        }
                    }

                    echo "\n✓ Manifests updated successfully"

                    // Commit and push changes to master branch
                    echo "\nCommitting k8s manifest updates to repository..."
                    withCredentials([sshUserPrivateKey(credentialsId: params.CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                        sh '''#!/bin/bash
                            set -euo pipefail

                            mkdir -p ~/.ssh
                            ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null || true
                            export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"

                            git config user.email "jenkins@securedrop.local"
                            git config user.name "Jenkins CI"

                            echo "Working tree status (before add):"
                            git status --porcelain || true

                            git add k8s/

                            echo "Staged files:" 
                            git diff --cached --name-only || true

                            if ! git diff --cached --quiet; then
                                git commit -m "CI: update k8s image tags - build ${BUILD_NUMBER}"
                                git remote set-url origin git@github.com:adreaskar/securedrop.git
                                git push origin HEAD:master
                            else
                                echo "No k8s manifest changes to commit"
                            fi
                        '''
                    }
                    echo "✓ Changes committed and pushed successfully"
                }
            }
        }

        stage('Trigger Update Manifests Pipeline') {
            when {
                expression { env.ROOT_SERVICE_CHANGES == 'true' || env.K8S_CHANGES == 'true' }
            }
            steps {
                script {
                    echo "\n=== Triggering Update Manifests Pipeline ==="
                    echo "Reason: ROOT_SERVICE_CHANGES=${env.ROOT_SERVICE_CHANGES}, K8S_CHANGES=${env.K8S_CHANGES}"
                    
                    try {
                        build job: 'update-manifests', wait: false
                        echo "✓ Update manifests pipeline triggered successfully"
                    } catch (Exception e) {
                        echo "⚠ Warning: Could not trigger update-manifests pipeline: ${e.message}"
                        // Don't fail the entire build if downstream job trigger fails
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh 'command -v docker >/dev/null 2>&1 && docker logout || true'
                sh 'command -v docker >/dev/null 2>&1 && docker image prune -a -f || true'
            }
        }
    }
}