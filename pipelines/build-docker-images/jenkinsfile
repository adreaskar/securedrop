// Map root-level service folders that have Dockerfiles
// These are the folders where docker builds will be triggered on changes
def rootServices = [
    'api'    : [dockerfiles: ['Dockerfile']],
    'webapp' : [dockerfiles: ['Dockerfile', 'Dockerfile.prod']],
    'nodered': [dockerfiles: ['Dockerfile.dev', 'Dockerfile']],
    'scanner': [dockerfiles: ['Dockerfile']]
]

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Show what would be built without pushing to Docker Hub')
    }

    triggers {
        githubPush()
    }

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        JENKINS_CI_EMAIL      = 'jenkins@securedrop.local'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_BRANCH_NAME   = 'master'
                    env.GIT_COMMIT        = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    env.GIT_COMMIT_SHORT  = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG         = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
                    env.SKIP_PIPELINE     = 'false'

                    echo "Branch: ${env.GIT_BRANCH_NAME}"
                    echo "Commit: ${env.GIT_COMMIT}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {

                    // -------------------------------------------------------
                    // Guard: skip builds triggered by Jenkins' own k8s commits
                    // -------------------------------------------------------
                    def lastCommitEmail = sh(
                        script: 'git log -1 --format="%ae"',
                        returnStdout: true
                    ).trim()

                    echo "Last commit author email: ${lastCommitEmail}"

                    if (lastCommitEmail == env.JENKINS_CI_EMAIL) {
                        env.SKIP_PIPELINE = 'true'
                        currentBuild.description = 'Skipped: Jenkins CI auto-commit'
                        echo 'Build triggered by Jenkins CI commit. Skipping pipeline.'
                        return
                    }

                    // -------------------------------------------------------
                    // Detect changed files
                    // -------------------------------------------------------
                    def changedFiles       = []
                    def servicesToBuild    = [] as Set
                    def k8sChanges         = false
                    def rootServiceChanges = false

                    try {
                        def previousCommit = sh(script: 'git rev-parse HEAD~1', returnStdout: true).trim()
                        changedFiles = sh(
                            script: "git diff --name-only ${previousCommit} HEAD",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }
                    } catch (Exception e) {
                        echo "Could not get previous commit (first build?). Listing all tracked files."
                        changedFiles = sh(
                            script: "git ls-files",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }
                    }

                    if (changedFiles.isEmpty()) {
                        env.SKIP_PIPELINE = 'true'
                        currentBuild.description = 'Skipped: no changes detected'
                        echo 'No changes detected.'
                        return
                    }

                    echo "Changed files:\n${changedFiles.join('\n')}"

                    for (String filePath in changedFiles) {
                        def topLevel = filePath.contains('/') ? filePath.split('/')[0] : filePath

                        if (topLevel == 'k8s') {
                            k8sChanges = true
                            echo "K8s change detected: ${filePath}"
                        }

                        if (rootServices.containsKey(topLevel)) {
                            servicesToBuild << topLevel
                            rootServiceChanges = true
                            echo "Service change detected: ${topLevel}"
                        }
                    }

                    env.K8S_CHANGES         = k8sChanges ? 'true' : 'false'
                    env.ROOT_SERVICE_CHANGES = rootServiceChanges ? 'true' : 'false'
                    env.SERVICES_TO_BUILD   = servicesToBuild.join(',')

                    echo "\n=== Change Detection Summary ==="
                    echo "K8s changes:      ${env.K8S_CHANGES}"
                    echo "Service changes:  ${env.ROOT_SERVICE_CHANGES}"
                    echo "Services to build: ${env.SERVICES_TO_BUILD ?: 'none'}"
                    echo "================================\n"
                }
            }
        }

        stage('Build and Push Images') {
            when {
                expression {
                    env.SKIP_PIPELINE != 'true' && env.ROOT_SERVICE_CHANGES == 'true'
                }
            }
            steps {
                script {
                    def servicesToBuild = env.SERVICES_TO_BUILD.split(',').collect { it.trim() }.findAll { it }

                    echo "Building ${servicesToBuild.size()} service(s) — tag: ${env.IMAGE_TAG}"

                    if (params.DRY_RUN) {
                        echo 'DRY RUN: no images will be built or pushed.'
                    } else {
                        sh 'echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin'
                    }

                    for (String serviceName in servicesToBuild) {
                        def serviceConfig = rootServices[serviceName]
                        def dockerfile    = null

                        // Pick the first Dockerfile that exists for this service
                        for (String candidate in serviceConfig.dockerfiles) {
                            def dockerfilePath = "${serviceName}/${candidate}"
                            if (fileExists(dockerfilePath)) {
                                dockerfile = dockerfilePath
                                break
                            }
                        }

                        if (!dockerfile) {
                            error("No Dockerfile found for service: ${serviceName}")
                        }

                        def imageName    = "${DOCKERHUB_CREDENTIALS_USR}/${serviceName}"
                        def fullImageTag = "${imageName}:${env.IMAGE_TAG}"

                        echo "\n=== Building ${serviceName} ==="
                        echo "Dockerfile: ${dockerfile}"
                        echo "Image tag:  ${fullImageTag}"

                        if (!params.DRY_RUN) {
                            sh """
                                docker build \
                                    -f "${dockerfile}" \
                                    -t "${fullImageTag}" \
                                    "./${serviceName}"
                            """
                            sh "docker push \"${fullImageTag}\""
                            echo "✓ Pushed: ${fullImageTag}"
                        }
                    }

                    if (!params.DRY_RUN) {
                        sh 'docker logout'
                    }
                }
            }
        }

        stage('Update k8s Manifests') {
            when {
                expression {
                    env.SKIP_PIPELINE != 'true' && env.ROOT_SERVICE_CHANGES == 'true'
                }
            }
            steps {
                script {
                    def servicesToBuild = env.SERVICES_TO_BUILD.split(',').collect { it.trim() }.findAll { it }

                    echo "Updating k8s manifests for: ${servicesToBuild.join(', ')}"

                    for (String serviceName in servicesToBuild) {
                        def k8sServiceDir = "k8s/${serviceName}"

                        if (!fileExists(k8sServiceDir)) {
                            echo "⚠ Warning: k8s directory not found for ${serviceName}: ${k8sServiceDir}"
                            continue
                        }

                        echo "\nUpdating manifests in: ${k8sServiceDir}"

                        def yamlFiles = sh(
                            script: "find ${k8sServiceDir} -name '*.yaml' -o -name '*.yml'",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }

                        def imageName    = "${DOCKERHUB_CREDENTIALS_USR}/${serviceName}"
                        def newImageTag  = "${imageName}:${env.IMAGE_TAG}"

                        for (String yamlFile in yamlFiles) {
                            if (!yamlFile) continue
                            echo "  → ${yamlFile}"
                            sh """
                                sed -i -e 's|image: ${imageName}:[^ ]*|image: ${newImageTag}|g' "${yamlFile}" || true
                            """
                        }
                    }

                    // Commit and push — [skip ci] prevents this push
                    // from triggering a new meaningful pipeline run
                    echo "\nCommitting k8s manifest updates..."
                    sh """
                        git config user.email "${env.JENKINS_CI_EMAIL}"
                        git config user.name "Jenkins CI"
                        git add k8s/
                        if ! git diff --cached --quiet; then
                            git commit -m "chore: update k8s image tags - build ${BUILD_NUMBER} [skip ci]"
                            git push origin HEAD:master
                            echo "✓ Manifests committed and pushed"
                        else
                            echo "No manifest changes to commit"
                        fi
                    """
                }
            }
        }

        stage('Trigger Update Manifests Pipeline') {
            when {
                expression {
                    env.SKIP_PIPELINE != 'true' &&
                    (env.ROOT_SERVICE_CHANGES == 'true' || env.K8S_CHANGES == 'true')
                }
            }
            steps {
                script {
                    echo "\n=== Triggering update-manifests ==="
                    echo "ROOT_SERVICE_CHANGES: ${env.ROOT_SERVICE_CHANGES}"
                    echo "K8S_CHANGES: ${env.K8S_CHANGES}"

                    try {
                        build job: 'update-manifests', wait: false
                        echo "✓ update-manifests triggered"
                    } catch (Exception e) {
                        echo "⚠ Warning: could not trigger update-manifests: ${e.message}"
                        // Do not fail the build if downstream trigger fails
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh 'command -v docker >/dev/null 2>&1 && docker logout || true'
                sh 'command -v docker >/dev/null 2>&1 && docker image prune -a -f || true'
            }
        }
        success {
            echo "✓ Pipeline completed successfully — build ${BUILD_NUMBER}"
        }
        failure {
            echo "✗ Pipeline failed — build ${BUILD_NUMBER}"
        }
    }
}
