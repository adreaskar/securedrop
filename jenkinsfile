// Map root-level service folders that have Dockerfiles
// These are the folders where docker builds will be triggered on changes
def rootServices = [
    'api': [dockerfiles: ['Dockerfile']],
    'webapp': [dockerfiles: ['Dockerfile.prod'], buildArgs: ['VITE_KEYCLOAK_URL','VITE_KEYCLOAK_REALM','VITE_KEYCLOAK_CLIENT_ID','VITE_API_BASE_URL']],
    'nodered': [dockerfiles: ['Dockerfile']],
    'stateless-scanner': [dockerfiles: ['Dockerfile']]
]

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Show what would be built without pushing to Docker Hub')
        string(name: 'CREDENTIAL_ID', defaultValue: 'manifest-repo-creds', description: 'SSH credential id with push access')
    }

    triggers {
        githubPush()
    }

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        VITE_KEYCLOAK_URL = "https://keycloak.securedrop.gr"
        VITE_KEYCLOAK_REALM = "securedrop-realm"
        VITE_KEYCLOAK_CLIENT_ID = "web-app"
        VITE_API_BASE_URL = "https://api.securedrop.gr/api"
    }

    stages {

        // =========================================================
        // STAGE: Checkout
        // =========================================================
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_BRANCH_NAME = 'master'
                    env.GIT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"

                    echo "Branch: ${env.GIT_BRANCH_NAME}"
                    echo "Commit: ${env.GIT_COMMIT}"
                    echo "Commit Short: ${env.GIT_COMMIT_SHORT}"
                    echo "Image Tag: ${env.IMAGE_TAG}"

                    // Skip pipeline if triggered by Jenkins own commit (prevents CI loop)
                    def lastCommitAuthor = sh(
                        script: 'git log -1 --format="%ae"',
                        returnStdout: true
                    ).trim()

                    echo "Last commit author: ${lastCommitAuthor}"

                    if (lastCommitAuthor == 'jenkins@securedrop.local') {
                        env.SKIP_PIPELINE = 'true'
                        currentBuild.description = 'Skipped: Jenkins CI commit'
                        echo "Triggered by Jenkins own commit — skipping pipeline."
                    }
                }
            }
        }

        // =========================================================
        // STAGE: Pre-flight Validation
        // =========================================================
        stage('Pre-flight Validation') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }
            steps {
                script {
                    echo "\n=== Pre-flight Validation ==="

                    // 1. Docker daemon accessible
                    echo "Checking Docker daemon..."
                    sh 'docker info > /dev/null'
                    echo "✓ Docker daemon is accessible"

                    // 2. Required env vars για webapp build args
                    echo "Checking required environment variables..."
                    def requiredVars = ['VITE_KEYCLOAK_URL', 'VITE_KEYCLOAK_REALM', 'VITE_KEYCLOAK_CLIENT_ID', 'VITE_API_BASE_URL']
                    requiredVars.each { v ->
                        if (!env.getProperty(v)) {
                            error("Pre-flight failed: Missing required env var: ${v}")
                        }
                        echo "✓ ${v} is set"
                    }

                    // 3. DockerHub credentials reachable (dry login)
                    if (!params.DRY_RUN) {
                        echo "Validating DockerHub credentials..."
                        sh 'echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin'
                        sh 'docker logout'
                        echo "✓ DockerHub credentials are valid"
                    } else {
                        echo "DRY RUN: Skipping DockerHub credential check"
                    }

                    echo "=== Pre-flight Validation Passed ===\n"
                }
            }
        }

        // =========================================================
        // STAGE: Detect Changes
        // =========================================================
        stage('Detect Changes') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }
            steps {
                script {
                    def changedFiles = []
                    def servicesToBuild = [] as Set
                    def k8sChangesDetected = false
                    def rootServiceChangesDetected = false

                    try {
                        def previousCommit = sh(script: 'git rev-parse HEAD~1', returnStdout: true).trim()
                        changedFiles = sh(
                            script: "git diff --name-only ${previousCommit} HEAD",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }
                    } catch (Exception e) {
                        echo "Could not get previous commit (first build?). Will process all changes."
                        changedFiles = sh(
                            script: "git diff --name-only HEAD~ HEAD || git ls-files",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }
                    }

                    if (changedFiles.isEmpty()) {
                        env.SKIP_PIPELINE = 'true'
                        currentBuild.description = 'Skipped: no changes detected'
                        echo 'No changes detected.'
                        return
                    }

                    echo "Changed files:\n${changedFiles.join('\n')}"

                    for (String filePath in changedFiles) {
                        def topLevel = filePath.contains('/') ? filePath.split('/')[0] : filePath

                        if (topLevel == 'k8s') {
                            k8sChangesDetected = true
                            echo "K8s directory change detected: ${filePath}"
                        }

                        if (rootServices.containsKey(topLevel)) {
                            servicesToBuild << topLevel
                            rootServiceChangesDetected = true
                            echo "Root service change detected in: ${topLevel}"
                        }
                    }

                    env.K8S_CHANGES = k8sChangesDetected ? 'true' : 'false'
                    env.ROOT_SERVICE_CHANGES = rootServiceChangesDetected ? 'true' : 'false'
                    env.SERVICES_TO_BUILD = servicesToBuild.join(',')

                    echo "\n=== Change Detection Summary ==="
                    echo "K8s changes detected: ${env.K8S_CHANGES}"
                    echo "Root service changes: ${env.ROOT_SERVICE_CHANGES}"
                    echo "Services to build: ${env.SERVICES_TO_BUILD ?: 'none'}"
                    echo "================================\n"
                }
            }
        }

        // =========================================================
        // STAGE: Lint Dockerfiles (hadolint)
        // =========================================================
        stage('Lint Dockerfiles') {
            when {
                expression { env.ROOT_SERVICE_CHANGES == 'true' }
            }
            steps {
                script {
                    def servicesToBuild = env.SERVICES_TO_BUILD.split(',').collect { it.trim() }.findAll { it }
                    def lintFailed = false

                    echo "\n=== Dockerfile Linting (hadolint) ==="

                    def hadolintAvailable = sh(script: 'command -v hadolint', returnStatus: true) == 0
                    if (!hadolintAvailable) {
                        echo "hadolint not found. Attempting to install..."
                        sh '''
                            curl -sSL -o /usr/local/bin/hadolint \
                                https://github.com/hadolint/hadolint/releases/latest/download/hadolint-Linux-x86_64
                            chmod +x /usr/local/bin/hadolint
                        '''
                    }

                    for (String serviceName in servicesToBuild) {
                        def serviceConfig = rootServices[serviceName]

                        for (String candidate in serviceConfig.dockerfiles) {
                            def dockerfilePath = "${serviceName}/${candidate}"
                            if (fileExists(dockerfilePath)) {
                                echo "Linting: ${dockerfilePath}"
                                def lintResult = sh(
                                    script: "hadolint ${dockerfilePath} --ignore DL3008 --ignore DL3009 --ignore DL3018",
                                    returnStatus: true
                                )
                                if (lintResult != 0) {
                                    echo "✗ Lint issues found in ${dockerfilePath}"
                                    lintFailed = true
                                } else {
                                    echo "✓ ${dockerfilePath} passed linting"
                                }
                            }
                        }
                    }

                    if (lintFailed) {
                        error("Dockerfile linting failed. Fix the above issues before building.")
                    }
                    echo "=== Linting Passed ===\n"
                }
            }
        }

        // =========================================================
        // STAGE: Build and Push Images
        // =========================================================
        stage('Build and Push Images') {
            when {
                expression { env.ROOT_SERVICE_CHANGES == 'true' }
            }
            steps {
                script {
                    def servicesToBuild = env.SERVICES_TO_BUILD.split(',').collect { it.trim() }.findAll { it }

                    echo "Building ${servicesToBuild.size()} services with tag: ${env.IMAGE_TAG}"

                    if (params.DRY_RUN) {
                        echo 'DRY RUN: No images will be built or pushed.'
                    } else {
                        sh 'echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin'
                    }

                    for (String serviceName in servicesToBuild) {
                        def serviceConfig = rootServices[serviceName]
                        def dockerfile = null
                        def buildArgsString = ''

                        for (String candidate in serviceConfig.dockerfiles) {
                            def dockerfilePath = "${serviceName}/${candidate}"
                            if (fileExists(dockerfilePath)) {
                                dockerfile = dockerfilePath
                                break
                            }
                        }

                        if (serviceConfig.containsKey('buildArgs')) {
                            def args = serviceConfig.buildArgs.collect { arg ->
                                def val = env.getProperty(arg)
                                return "--build-arg ${arg}=${val ?: ''}"
                            }
                            buildArgsString = args.join(' ')
                        }

                        if (!dockerfile) {
                            error("No Dockerfile found for service: ${serviceName}")
                        }

                        def imageName = "${DOCKERHUB_CREDENTIALS_USR}/${serviceName}"
                        def fullImageTag = "${imageName}:${env.IMAGE_TAG}"

                        echo "\n=== Building ${serviceName} ==="
                        echo "Dockerfile: ${dockerfile}"
                        echo "Image tag: ${fullImageTag}"

                        if (!params.DRY_RUN) {
                            sh """
                                docker build \
                                    -f "${dockerfile}" \
                                    ${buildArgsString} \
                                    -t "${fullImageTag}" \
                                    "./${serviceName}"
                            """

                            sh "docker push \"${fullImageTag}\""
                            echo "✓ Successfully pushed: ${fullImageTag}"

                            // ---------------------------------------------------------
                            // TEST 1: Smoke test
                            // ---------------------------------------------------------
                            echo "Running smoke test for ${fullImageTag}..."
                            def smokeResult = sh(
                                script: "docker run --rm --entrypoint '' \"${fullImageTag}\" echo SMOKE_OK",
                                returnStatus: true
                            )
                            if (smokeResult != 0) {
                                error("Smoke test failed for ${fullImageTag}: container did not start cleanly")
                            }
                            echo "✓ Smoke test passed for ${serviceName}"

                            // ---------------------------------------------------------
                            // TEST 2: Image size check (soft limit 500MB)
                            // ---------------------------------------------------------
                            echo "Checking image size for ${fullImageTag}..."
                            def sizeBytes = sh(
                                script: "docker inspect \"${fullImageTag}\" --format='{{.Size}}'",
                                returnStdout: true
                            ).trim().toLong()
                            def sizeMB = sizeBytes / 1_000_000
                            echo "Image size: ${sizeMB}MB"
                            if (sizeBytes > 500_000_000L) {
                                echo "⚠ Warning: ${serviceName} image is ${sizeMB}MB (> 500MB). Consider optimizing."
                            } else {
                                echo "✓ Image size OK (${sizeMB}MB)"
                            }

                            // ---------------------------------------------------------
                            // TEST 3: Trivy vulnerability scan (CRITICAL only)
                            // ---------------------------------------------------------
                            echo "Running Trivy vulnerability scan for ${fullImageTag}..."
                            def trivyAvailable = sh(script: 'command -v trivy', returnStatus: true) == 0
                            if (trivyAvailable) {
                                def trivyResult = sh(
                                    script: """
                                        trivy image \
                                            --exit-code 1 \
                                            --severity CRITICAL \
                                            --ignore-unfixed \
                                            --no-progress \
                                            \"${fullImageTag}\"
                                    """,
                                    returnStatus: true
                                )
                                if (trivyResult != 0) {
                                    error("Trivy scan failed: CRITICAL vulnerabilities found in ${fullImageTag}")
                                }
                                echo "✓ Trivy scan passed for ${serviceName}"
                            } else {
                                echo "⚠ trivy not found — skipping vulnerability scan."
                            }
                        }
                    }

                    if (!params.DRY_RUN) {
                        sh 'docker logout'
                    }
                }
            }
        }

        // =========================================================
        // STAGE: Update k8s directories
        // =========================================================
        stage('Update k8s directories') {
            when {
                expression { env.ROOT_SERVICE_CHANGES == 'true' }
            }
            steps {
                script {
                    def servicesToBuild = env.SERVICES_TO_BUILD.split(',').collect { it.trim() }.findAll { it }

                    echo "Updating k8s manifests for built services..."

                    for (String serviceName in servicesToBuild) {
                        def k8sServiceDir = "k8s/${serviceName}"

                        if (!fileExists(k8sServiceDir)) {
                            echo "⚠ Warning: k8s directory not found for ${serviceName}: ${k8sServiceDir}"
                            continue
                        }

                        echo "\nUpdating deployment manifests in: ${k8sServiceDir}"

                        def deploymentFiles = sh(
                            script: """find ${k8sServiceDir} -type f \\( -name '*deployment*.yaml' -o -name '*deployment*.yml' -o -name '*knative*.yaml' -o -name '*knative*.yml' \\)""",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }

                        def imageName = "${DOCKERHUB_CREDENTIALS_USR}/${serviceName}"
                        def newImageTag = "${imageName}:${env.IMAGE_TAG}"

                        for (String deploymentFile in deploymentFiles) {
                            if (!deploymentFile) continue

                            echo "Updating image tag in: ${deploymentFile}"

                            sh """
                                sed -i -E 's|^([[:space:]]*image:[[:space:]]*)[^[:space:]]*${serviceName}:[^[:space:]]+|\\1${newImageTag}|' "${deploymentFile}" || true
                            """

                            // ---------------------------------------------------------
                            // TEST 4: Verify sed replacement
                            // ---------------------------------------------------------
                            echo "Verifying image tag update in ${deploymentFile}..."
                            def tagFound = sh(
                                script: "grep -c '${env.IMAGE_TAG}' \"${deploymentFile}\" || true",
                                returnStdout: true
                            ).trim()

                            if (tagFound == '0') {
                                error("Manifest update verification failed: '${env.IMAGE_TAG}' not found in ${deploymentFile}.")
                            }
                            echo "✓ Image tag verified in ${deploymentFile}"
                        }

                        // ---------------------------------------------------------
                        // TEST 5: kubeval manifest validation (no cluster needed)
                        // ---------------------------------------------------------
                        echo "Validating k8s manifests (kubeval) for ${serviceName}..."
                        def kubevalAvailable = sh(script: 'command -v kubeval', returnStatus: true) == 0
                        if (kubevalAvailable) {
                            def kubevalResult = sh(
                                script: "find ${k8sServiceDir} -name '*.yaml' -o -name '*.yml' | xargs kubeval --strict --ignore-missing-schemas 2>&1",
                                returnStatus: true
                            )
                            if (kubevalResult != 0) {
                                error("kubeval validation failed for ${k8sServiceDir}/.")
                            }
                            echo "✓ kubeval passed for ${serviceName}"
                        } else {
                            echo "⚠ kubeval not found — skipping manifest validation."
                        }
                    }

                    echo "\n✓ Manifests updated successfully"

                    // ---------------------------------------------------------
                    // TEST 6: Unexpected staged files check
                    // ---------------------------------------------------------
                    sh 'git add k8s/'

                    echo "Checking for unexpected staged files outside k8s/..."
                    def unexpectedChanges = sh(
                        script: "git diff --cached --name-only | grep -v '^k8s/' || true",
                        returnStdout: true
                    ).trim()

                    if (unexpectedChanges) {
                        error("Unexpected files staged for commit (outside k8s/):\n${unexpectedChanges}")
                    }
                    echo "✓ Only k8s/ files are staged"

                    // Commit and push
                    echo "\nCommitting k8s manifest updates to repository..."
                    withCredentials([sshUserPrivateKey(credentialsId: params.CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                        sh '''#!/bin/bash
                            set -euo pipefail

                            mkdir -p ~/.ssh
                            ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null || true
                            export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"

                            git config user.email "jenkins@securedrop.local"
                            git config user.name "Jenkins CI"

                            echo "Working tree status (before add):"
                            git status --porcelain || true

                            echo "Staged files:"
                            git diff --cached --name-only || true

                            if ! git diff --cached --quiet; then
                                git commit -m "CI: update k8s image tags - build ${BUILD_NUMBER}"
                                git remote set-url origin git@github.com:adreaskar/securedrop.git
                                git push origin HEAD:master
                            else
                                echo "No k8s manifest changes to commit"
                            fi
                        '''
                    }
                    echo "✓ Changes committed and pushed successfully"
                }
            }
        }

        // =========================================================
        // STAGE: Sync k8s to manifests branch
        // =========================================================
        stage('Sync k8s to manifests branch') {
            when {
                expression { env.ROOT_SERVICE_CHANGES == 'true' || env.K8S_CHANGES == 'true' }
            }
            steps {
                script {
                    echo "\n=== Syncing k8s folder to manifests branch ==="

                    withCredentials([sshUserPrivateKey(credentialsId: params.CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                        sh '''#!/bin/bash
                            set -euo pipefail

                            mkdir -p ~/.ssh
                            ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null || true
                            export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"

                            WORK_DIR=$(dirname "${WORKSPACE}")
                            MANIFESTS_DIR="${WORK_DIR}/manifests-repo"
                            SOURCE_K8S="${WORKSPACE}/k8s"

                            rm -rf "${MANIFESTS_DIR}"
                            git clone --branch manifests git@github.com:adreaskar/securedrop.git "${MANIFESTS_DIR}"

                            echo "Syncing k8s folder from ${SOURCE_K8S} into manifests repo root..."

                            if [ ! -d "${SOURCE_K8S}" ]; then
                                echo "ERROR: Source k8s directory not found at ${SOURCE_K8S}"
                                exit 1
                            fi

                            cd "${MANIFESTS_DIR}"
                            git config user.email "jenkins@securedrop.local"
                            git config user.name "Jenkins CI"

                            rsync -a --delete --exclude '.git/' "${SOURCE_K8S}/" ./

                            if git status --porcelain | grep -q .; then
                                echo "✓ K8s changes detected, committing..."
                                git add -A
                                git commit -m "CI: Sync k8s folder from master - build ${BUILD_NUMBER}"
                                git push origin manifests
                                echo "✓ Manifests branch updated successfully"
                            else
                                echo "No manifest changes detected after sync"
                            fi
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh 'command -v docker >/dev/null 2>&1 && docker logout || true'
                sh 'command -v docker >/dev/null 2>&1 && docker image prune -a -f || true'
            }
        }
        success {
            echo "\n✓ Pipeline completed successfully — Build: ${env.BUILD_NUMBER}, Tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo "\n✗ Pipeline failed — Build: ${env.BUILD_NUMBER}. Check logs above for details."
        }
    }
}