  {
    "id": "extract-metadata",
    "type": "function",
    "z": "7445738352719b18",
    "name": "Extract Key & Bucket",
    "func": "// Check if this is a valid S3 put event\nif (!msg.payload.Records || !msg.payload.Records[0]) {\n    return null;\n}\n\n// Extract details\nconst s3 = msg.payload.Records[0].s3;\nconst objectKey = decodeURIComponent(s3.object.key.replace(/\\+/g, \" \"));\nconst bucketName = s3.bucket.name;\n\n// 1. The S3 node looks specifically for 'msg.bucket'\nmsg.bucket = bucketName;\n\n// 2. The S3 node looks specifically for 'msg.filename'\nmsg.filename = objectKey;\nmsg.fileId = objectKey.split(\"/\")[1];\nmsg.fileExt = objectKey.split(\"/\")[2];\n\n// Cleanup: remove the huge raw event payload to keep memory clean\n// (Optional, but good practice)\ndelete msg.payload;\n\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 300,
    "y": 300,
    "wires": [["d5e3ef6df3a15b76", "825f1a4dac11443d"]]
  },
  {
    "id": "0296b4eb7bf638a3",
    "type": "function",
    "z": "7445738352719b18",
    "name": "Scan file",
    "func": "// 'NodeClam' and 'Stream' are injected via the Setup tab.\n\nconst clamscanConfig = {\n    clamdscan: {\n        host: 'clamav',\n        port: 3310,\n        timeout: 60000,\n        socket: null,\n    },\n    preference: 'clamdscan'\n};\n\n// Initialize the scanner\nconst ClamScan = new NodeClam().init(clamscanConfig);\n\nreturn (async () => {\n    try {\n        // Create the stream using the injected 'Stream' variable\n        const bufferStream = new Stream.PassThrough();\n        bufferStream.end(msg.payload);\n\n        // Perform the scan\n        const { isInfected, viruses } = await ClamScan.then(scanner => scanner.scanStream(bufferStream));\n\n        msg.headers = msg.headers || {};\n\n        if (isInfected) {\n            msg.bucketName = \"rejected\";\n            msg.objectName = msg.filename;\n            msg.sourceObject = msg.bucket + \"/\" + msg.filename;\n\n            // Construct this for web app\n            msg.webapp = {\n                fileId: msg.fileId,\n                status: \"rejected\",\n                scanResults: viruses\n            }\n            // Construct this for thingsboard\n            msg.thingsboard = {\n                filename: msg.fileExt,\n                status: \"INFECTED\",\n                viruses\n            }\n            \n        } else {\n            msg.bucketName = \"approved\";\n            msg.objectName = msg.filename;\n            msg.sourceObject = msg.bucket + \"/\" + msg.filename;\n\n            // Construct this for web app\n            msg.webapp = {\n                fileId: msg.fileId,\n                status: \"approved\",\n                scanResults: viruses\n            }\n            // Construct this for thingsboard\n            msg.thingsboard = {\n                filename: msg.fileExt,\n                status: \"CLEAN\",\n                viruses\n            }\n        }\n        \n        msg.scanStatus = isInfected ? \"INFECTED\" : \"CLEAN\";\n        msg.isInfected = isInfected;\n        msg.viruses = viruses;\n        \n        return msg;\n\n    } catch (err) {\n        node.error(\"ClamAV Scan Error: \" + err.message);\n        msg.payload = { error: err.message };\n        return [null, msg];\n    }\n})();",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [
      {
        "var": "NodeClam",
        "module": "clamscan"
      },
      {
        "var": "Stream",
        "module": "stream"
      }
    ],
    "x": 320,
    "y": 400,
    "wires": [["14d665e8f1c43ed2", "30eee9150ec030b1"]]
  },
