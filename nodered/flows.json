    {
        "id": "a0fc106a6350b693",
        "type": "function",
        "z": "7445738352719b18",
        "name": "prepare faas data",
        "func": "let event = msg.payload;\n\nif (Buffer.isBuffer(event)) {\n    event = event.toString(\"utf8\");\n}\n\nif (typeof event === \"string\") {\n    event = JSON.parse(event);\n}\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = event;\n\nconst objectKey = event.Records?.[0]?.s3?.object?.key || event.objectKey || event.key || '';\nmsg.fileId = event.fileId || objectKey.split('/')[1] || objectKey || 'unknown';\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
