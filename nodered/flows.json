    {
        "id": "1eabd0a4e3bf48b0",
        "type": "function",
        "z": "7445738352719b18",
        "name": "prepare thingsboard data",
        "func": "const scan = msg.payload;\n\nconst objectKey = scan.objectKey || \"\";\nconst filename = objectKey.split(\"/\").pop() || objectKey;\nconst extension = filename.includes(\".\")\n    ? filename.split(\".\").pop().toLowerCase()\n    : \"\";\n\nconst sizeBytes = Number(\n    scan.file_size_bytes ??\n    scan.fileSizeBytes ??\n    scan.fileSize ??\n    scan.file_size ??\n    scan.size ??\n    scan.objectSize ??\n    0\n);\n\nconst sizeMB = Number((sizeBytes / (1024 * 1024)).toFixed(2));\n\nnode.warn({\n    fileId: scan.fileId,\n    filename,\n    detected_size_bytes: sizeBytes,\n    detected_size_mb: sizeMB,\n    available_keys: Object.keys(scan)\n});\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    fileId: scan.fileId,\n    filename,\n    file_type: extension,\n    status: scan.status,\n    clean: scan.clean,\n    scan_result: scan.scanResult,\n    scan_duration_ms: scan.scan_duration_ms,\n    bucket: scan.bucket,\n    objectKey: scan.objectKey,\n\n    total_scanned: 1,\n    infected_count: scan.clean ? 0 : 1,\n\n    // Αυτό ακριβώς ψάχνει το ThingsBoard widget:\n    file_size_mb: sizeMB,\n\n    // Χρήσιμο και για table/debug:\n    file_size_bytes: sizeBytes\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
