    {
        "id": "a99dcfdc83b1377d",
        "type": "function",
        "z": "7445738352719b18",
        "name": "send nack",
        "func": "const msgId = String(msg.fileId || 'fallback').replace(/[^a-zA-Z0-9_-]/g, '_');\n\nconst retries = flow.get(`retry_${msgId}`) || 0;\n\nif (retries < 1) {\n    flow.set(`retry_${msgId}`, retries + 1);\n    msg.manualAck = { ackMode: \"nack\", requeue: true };\n} else {\n    flow.set(`retry_${msgId}`, undefined);\n    msg.manualAck = { ackMode: \"nack\", requeue: false };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
